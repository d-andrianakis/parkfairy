{
  "mcpServers": {
    "playwright": {
      "command": "node",
      "args": [
        "node_modules/@playwright/mcp/cli.js",
        "--browser",
        "chrome",
        "--isolated",
        "--no-webmcp",
        "--allowed-origins",
        "http://localhost:3000;http://localhost:4000;http://localhost:4100",
        "--output-dir",
        ".playwright-mcp"
      ]
    }
  }
}
