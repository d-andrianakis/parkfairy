# Copy to .env at the repository root. Every app reads this single file in development.

# --- Database (docker compose maps Postgres to 5434 to avoid clashing with a local 5432)
DATABASE_URL=postgres://parkfairy:parkfairy@localhost:5434/parkfairy
# Used by the API integration tests; the database is created by infra/postgres/init.
TEST_DATABASE_URL=postgres://parkfairy:parkfairy@localhost:5434/parkfairy_test

# --- Redis (BullMQ queues; rate-limit counters shared by API and web instances)
REDIS_URL=redis://localhost:6380
# Optional: Redis for the rate-limit integration test (defaults to REDIS_URL, database 15).
# TEST_REDIS_URL=redis://localhost:6380/15

# --- Auth (Better Auth). Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Public origin of the web app; Better Auth handlers are mounted there.
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated origins allowed to make credentialed, state-changing requests.
TRUSTED_ORIGINS=http://localhost:3000
# Addresses/CIDRs of the proxies in front of the web app (load balancer, CDN), so Better Auth
# finds the real client IP for its rate limits; "none" when visitors connect directly (as
# locally). Required in production. Also set the API's TRUST_PROXY.
TRUSTED_PROXIES=none

# --- Email (Resend). Leave the key empty on this machine: emails then become JSON files in
# .emails/ at the repository root, each with its link. Any other BETTER_AUTH_URL needs a key.
RESEND_API_KEY=
# Required with the key, on a domain verified with Resend.
# EMAIL_FROM=Parkfairy <no-reply@example.gr>
# Optional: another folder for those files.
# EMAIL_OUTBOX_DIR=

# --- Web
# Where Next.js proxies /api/v1/* (server-side only; browsers stay same-origin).
API_URL=http://localhost:4000

# --- API
API_PORT=4000
# Only set when the API is exposed directly on its own origin (e.g. api.example.gr).
API_CORS_ORIGINS=
# Express "trust proxy": the web servers' addresses/CIDRs (they call the API), "loopback"
# when on the same host, or "false". Required in production. Never a count of the proxies in
# front of the web app: the web server adds no X-Forwarded-For hop of its own.
TRUST_PROXY=loopback
LOG_LEVEL=info

# --- Worker
WORKER_HEALTH_PORT=4100
