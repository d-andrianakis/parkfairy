# Copy to .env at the repository root. Every app reads this single file in development.

# --- Database (docker compose maps Postgres to 5434 to avoid clashing with a local 5432)
DATABASE_URL=postgres://parkfairy:parkfairy@localhost:5434/parkfairy
# Used by the API integration tests; the database is created by infra/postgres/init.
TEST_DATABASE_URL=postgres://parkfairy:parkfairy@localhost:5434/parkfairy_test

# --- Redis (BullMQ queues; rate-limit counters shared by API and web instances)
REDIS_URL=redis://localhost:6380
# Optional: Redis for the rate-limit integration test (defaults to REDIS_URL, database 15).
# TEST_REDIS_URL=redis://localhost:6380/15

# --- Auth (Better Auth). Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Public origin of the web app; Better Auth handlers are mounted there.
BETTER_AUTH_URL=http://localhost:3000
# Public origin of the staff app (apps/admin). It signs staff in on this origin, so its cookie never
# reaches the public site (#66): in production on a different HOSTNAME from BETTER_AUTH_URL (cookies
# ignore ports) and over https. The API takes writes from it too, from this variable; do NOT add it to
# TRUSTED_ORIGINS, which the public site's Better Auth also trusts.
ADMIN_URL=http://localhost:3001
# Comma-separated origins allowed to make credentialed, state-changing requests (besides the web app).
TRUSTED_ORIGINS=http://localhost:3000
# Addresses/CIDRs of the proxies in front of the web app (load balancer, CDN), so Better Auth
# finds the real client IP for its rate limits; "none" when visitors connect directly (as
# locally). Required in production. Also set the API's TRUST_PROXY.
TRUSTED_PROXIES=none

# --- Email (Resend). Leave the key empty on this machine: emails then become JSON files in
# .emails/ at the repository root, each with its link. Any other BETTER_AUTH_URL needs a key.
RESEND_API_KEY=
# Required with the key, on a domain verified with Resend.
# EMAIL_FROM=Parkfairy <no-reply@example.gr>
# Optional: another folder for those files.
# EMAIL_OUTBOX_DIR=
# Optional: how many emails a second the worker sends (default 1). Resend's limit is the
# account's, 2 a second unless Resend raises it, and the web app's account emails take one of
# them: raise this only with the account's limit.
# EMAIL_SENDS_PER_SECOND=1

# --- Uploads (listing photos and proof documents). Leave the bucket empty on this machine: files
# then go to .uploads/ at the repository root. Any other BETTER_AUTH_URL needs a bucket.
S3_BUCKET=
# S3_REGION=eu-central-1
# Only for S3-compatible stores.
# S3_ENDPOINT=
# Credentials come from the SDK's usual chain (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, roles).
# Optional: another folder for those files.
# OBJECT_STORE_DIR=

# --- Owners. Encrypts tax numbers and birth dates; generate with: openssl rand -base64 32
# Required unless BETTER_AUTH_URL is this machine. Losing it loses those values.
OWNER_DATA_KEY=

# --- Maps. A PUBLIC Mapbox token (pk...), restricted to your site's URLs in the Mapbox account.
# Leave it empty and the location step falls back to typed coordinates and "use my location",
# and search offers no address field and no results map.
MAPBOX_PUBLIC_TOKEN=
# Address search, called by the API (not the browser). A token WITHOUT URL restrictions: Mapbox
# refuses restricted ones from a server. Empty: the API uses MAPBOX_PUBLIC_TOKEN, enough locally.
MAPBOX_SEARCH_TOKEN=
# Mapbox calls the whole site may make in a clock hour, so a flood can't run up the bill.
MAPBOX_SEARCH_HOURLY_LIMIT=2000

# --- Payments (Phase 4), Stripe TEST mode only until the adviser (#18) and Stripe (#19) answer:
# live keys are refused. All three empty: owners can't set up payouts, and only this machine books,
# without paying (decisions #33, #47). The secret key and the webhook's signing secret go together
# (the API's); the publishable key goes to drivers' browsers (the web app's). The worker uses the
# secret key too: it sends refunds left owed and owners' transfers, 24 hours after each stay.
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:4000/v1/payments/webhook`, or the endpoint's secret.
# The endpoint must send every event the API reads (one left out fails quietly: without the
# dispute events no payout is held): account.updated, payment_intent.succeeded,
# payment_intent.processing, payment_intent.payment_failed, payment_intent.canceled,
# refund.updated, refund.failed, charge.refund.updated, charge.dispute.created,
# charge.dispute.updated, charge.dispute.closed, charge.dispute.funds_withdrawn,
# charge.dispute.funds_reinstated.
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# --- Web
# Where Next.js proxies /api/v1/* (server-side only; browsers stay same-origin).
API_URL=http://localhost:4000

# --- API
API_PORT=4000
# Only set when the API is exposed directly on its own origin (e.g. api.example.gr).
API_CORS_ORIGINS=
# Express "trust proxy": the web servers' addresses/CIDRs (they call the API), "loopback"
# when on the same host, or "false". Required in production. Never a count of the proxies in
# front of the web app: the web server adds no X-Forwarded-For hop of its own.
TRUST_PROXY=loopback
LOG_LEVEL=info

# --- Worker
WORKER_HEALTH_PORT=4100
